-- 4. Stored procedure and views (english names)
CREATE OR ALTER PROCEDURE dbo.usp_AddSession
  @PsychologistID INT,
  @ClientID INT,
  @ServiceID INT,
  @SessionDT DATETIME2(7)
AS
BEGIN
  SET NOCOUNT ON;
  BEGIN TRY
    IF EXISTS (SELECT 1 FROM dbo.Sessions WHERE PsychologistID=@PsychologistID AND SessionDateTime=@SessionDT)
      THROW 50001, N'Psychologist already has a session at this time.', 1;

    INSERT INTO dbo.Sessions (PsychologistID, ClientID, ServiceID, SessionDateTime, PaymentStatus)
    VALUES (@PsychologistID, @ClientID, @ServiceID, @SessionDT, 0);

    SELECT CAST(SCOPE_IDENTITY() AS INT) AS SessionID;
  END TRY
  BEGIN CATCH
    DECLARE @msg NVARCHAR(4000)=ERROR_MESSAGE();
    RAISERROR(@msg,16,1);
  END CATCH
END
GO

CREATE OR ALTER VIEW dbo.vw_SessionSchedule AS
SELECT s.SessionID, p.FullName AS Psychologist, c.FullName AS Client, sv.Name AS Service, s.SessionDateTime, s.PaymentStatus
FROM dbo.Sessions s
JOIN dbo.Psychologists p ON s.PsychologistID = p.PsychologistID
JOIN dbo.Clients c ON s.ClientID = c.ClientID
LEFT JOIN dbo.Services sv ON s.ServiceID = sv.ServiceID;
GO

CREATE OR ALTER VIEW dbo.vw_ClientDebts AS
SELECT c.ClientID, c.FullName, COUNT(s.SessionID) AS UnpaidSessions,
       SUM(COALESCE(sv.Price, ph.Fee,0)) AS DebtAmount
FROM dbo.Sessions s
JOIN dbo.Clients c ON s.ClientID = c.ClientID
LEFT JOIN dbo.Services sv ON s.ServiceID = sv.ServiceID
LEFT JOIN dbo.Psychologists ph ON s.PsychologistID = ph.PsychologistID
WHERE s.PaymentStatus = 0
GROUP BY c.ClientID, c.FullName;
GO

-- 5. Triggers
CREATE OR ALTER TRIGGER dbo.trg_Sessions_Audit
ON dbo.Sessions
AFTER INSERT, UPDATE, DELETE
AS
BEGIN
  SET NOCOUNT ON;

  -- INSERT: record old = inserted values to avoid NULLs (per request)
  INSERT INTO dbo.SessionAudit(Operation, SessionID, OldPaymentStatus, NewPaymentStatus, OldSessionDateTime, NewSessionDateTime, [User], OperationAt)
  SELECT N'INSERT', i.SessionID, COALESCE(i.PaymentStatus,0), COALESCE(i.PaymentStatus,0), COALESCE(i.SessionDateTime,'1900-01-01'), i.SessionDateTime, SUSER_SNAME(), SYSUTCDATETIME()
  FROM inserted i
  LEFT JOIN deleted d ON d.SessionID = i.SessionID
  WHERE d.SessionID IS NULL;

  -- UPDATE
  INSERT INTO dbo.SessionAudit(Operation, SessionID, OldPaymentStatus, NewPaymentStatus, OldSessionDateTime, NewSessionDateTime, [User], OperationAt)
  SELECT N'UPDATE', i.SessionID, COALESCE(d.PaymentStatus,i.PaymentStatus,0), COALESCE(i.PaymentStatus,0), COALESCE(d.SessionDateTime,i.SessionDateTime,'1900-01-01'), COALESCE(i.SessionDateTime,'1900-01-01'), SUSER_SNAME(), SYSUTCDATETIME()
  FROM inserted i
  INNER JOIN deleted d ON d.SessionID = i.SessionID;

  -- DELETE
  INSERT INTO dbo.SessionAudit(Operation, SessionID, OldPaymentStatus, OldSessionDateTime, [User], OperationAt)
  SELECT N'DELETE', d.SessionID, COALESCE(d.PaymentStatus,0), COALESCE(d.SessionDateTime,'1900-01-01'), SUSER_SNAME(), SYSUTCDATETIME()
  FROM deleted d
  LEFT JOIN inserted i ON i.SessionID = d.SessionID
  WHERE i.SessionID IS NULL;
END
GO

CREATE OR ALTER TRIGGER dbo.trg_Payments_UpdateStatus
ON dbo.Payments
AFTER INSERT
AS
BEGIN
  SET NOCOUNT ON;
  ;WITH ChangedSessions AS (
    SELECT DISTINCT SessionID FROM inserted WHERE SessionID IS NOT NULL
  )
  UPDATE s
  SET PaymentStatus = CASE WHEN paid.TotalPaid >= due.DueAmount AND due.DueAmount > 0 THEN 1 ELSE 0 END
  FROM dbo.Sessions s
  INNER JOIN ChangedSessions ch ON s.SessionID = ch.SessionID
  CROSS APPLY (
    SELECT ISNULL(SUM(o.Amount),0) AS TotalPaid FROM dbo.Payments o WHERE o.SessionID = ch.SessionID
  ) paid
  CROSS APPLY (
    SELECT TOP(1) COALESCE(sv.Price, ph.Fee, 0) AS DueAmount
    FROM dbo.Sessions ss
    LEFT JOIN dbo.Services sv ON ss.ServiceID = sv.ServiceID
    LEFT JOIN dbo.Psychologists ph ON ss.PsychologistID = ph.PsychologistID
    WHERE ss.SessionID = ch.SessionID
  ) due;
END
GO

